{
  "name": "dsh-sandbox-keeper",
  "version": "0.1.0",
  "description": "Remote-sandbox lifecycle owner for DeepSeek Harness: E2B sandbox create/pause/resume, sidecar deployment, heartbeat keep-alive, crash-transparent recovery, and pluggable tar IN/OUT sync.",
  "type": "module",
  "license": "MIT",
  "author": "weijiafu8",
  "keywords": ["dsh-plugin", "deepseek-harness", "sandbox", "e2b"],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    }
  },
  "files": ["lib", "src"],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "dsh-remote-protocol": "workspace:*",
    "dsh-remote-sidecar": "workspace:*",
    "e2b": "2.29.1",
    "ws": "^8.18.0",
    "tar": "^7.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-invariants": ">=0.0.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-invariants": "workspace:*",
    "@types/ws": "^8.5.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
